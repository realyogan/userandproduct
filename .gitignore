# WordPress core (installed with WP-CLI, not versioned)
/wp-admin/
/wp-includes/
/wp-*.php
/index.php
/license.txt
/readme.html
/xmlrpc.php
/wp-config.php
/.htaccess

# wp-content: only our theme and plugin are tracked (re-include them by name once they exist)
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/plugins/
/wp-content/plugins/*
/wp-content/uploads/

# Local secrets, logs, OS junk, machine-local assistant settings
/.local/
*.log
Thumbs.db
.DS_Store
__pycache__/
/.claude/settings.local.json
/.claude/**/evals/outputs/

# Satoshi (ITF Free Font License): the licence bars making the files available through a public
# repository, so the font files stay local. Get them from https://www.fontshare.com/fonts/satoshi.
# The README beside them is tracked. The owner decides if this changes.
/research/mockups/fonts/satoshi/*
!/research/mockups/fonts/satoshi/README.md
/research/mockups/option-1/assets/fonts/satoshi/

# Book covers for the Books mockup: the art is the publishers' copyright and this repo is public, so the
# image files stay local. The README beside them (tracked) lists each file's ISBN, Open Library cover id and
# source URL so they can be fetched again.
/research/mockups/option-1/img/books/covers/*
!/research/mockups/option-1/img/books/covers/README.md
