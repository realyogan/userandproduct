# WordPress core (installed with WP-CLI, not versioned)
/wp-admin/
/wp-includes/
/wp-*.php
/index.php
/license.txt
/readme.html
/xmlrpc.php
/wp-config.php
/.htaccess

# wp-content: only our theme and plugin are tracked (re-include them by name once they exist)
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/plugins/
/wp-content/plugins/*
/wp-content/uploads/

# Local secrets, logs, OS junk, machine-local assistant settings
/.local/
*.log
Thumbs.db
.DS_Store
__pycache__/
/.claude/settings.local.json
/.claude/**/evals/outputs/
